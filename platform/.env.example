export PLATFORMD_ADDR=127.0.0.1:8420
export PLATFORMD_DATABASE_PATH=.data/platformd.sqlite
export PLATFORMD_FILES_DIR=.data/files
export PLATFORMD_MAX_UPLOAD_BYTES=20971520
export PLATFORMD_BOOTSTRAP_IDENTIFIER=admin
export PLATFORMD_BOOTSTRAP_PASSWORD=change-this-before-first-run
export PLATFORMD_SESSION_TTL=12h
export PLATFORMD_SESSION_IDLE_TTL=30m
export PLATFORMD_LOGIN_THROTTLE_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
export PLATFORMD_LOGIN_THROTTLE_WINDOW=15m
export PLATFORMD_LOGIN_THROTTLE_LOCKOUT=15m
export PLATFORMD_LOGIN_THROTTLE_FAILURES=5
export PLATFORMD_SESSION_SECURE_COOKIE=false
export PLATFORMD_PUBLIC_URL=https://identity.example.internal/crate-api/identity/v1
export PLATFORMD_TRUSTED_PROXY_CIDRS=127.0.0.1/32
export PLATFORMD_CORS_ORIGINS=http://localhost:4324,http://127.0.0.1:4324

# 邮件链接登录（Agora）。PLATFORMD_SMTP_ADDR 为空表示不启用该登录方式。
# PLATFORMD_EMAIL_LINK_REDIRECT_URIS 必须与 agora-api 的 AGORA_EMAIL_LINK_REDIRECT_URI 完全一致。
export PLATFORMD_EMAIL_LINK_TTL=10m
export PLATFORMD_EMAIL_LINK_REDIRECT_URIS=http://localhost:4321/
export PLATFORMD_EMAIL_LINK_RATE_WINDOW=15m
export PLATFORMD_EMAIL_LINK_EMAIL_LIMIT=3
export PLATFORMD_EMAIL_LINK_SOURCE_LIMIT=10
# export PLATFORMD_SMTP_ADDR=smtp.example.com:587
export PLATFORMD_SMTP_FROM=
export PLATFORMD_SMTP_USERNAME=
export PLATFORMD_SMTP_PASSWORD=
export PLATFORMD_SMTP_TLS=starttls
export PLATFORMD_SMTP_TIMEOUT=10s
