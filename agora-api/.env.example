# HTTP server
HTTP_ADDR=:8080

# PostgreSQL
DATABASE_URL=postgres://agora:agora@localhost:5432/agora?sslmode=disable
DB_MAX_CONNS=10

# Browser origins allowed to call the API (comma separated, exact match).
# Add the exact origin used by the browser, e.g. http://192.168.0.109:4321
ALLOWED_ORIGINS=http://localhost:4321,http://127.0.0.1:4321

# Identity and base-data services (server-to-server)
IDENTITY_BASE_URL=http://127.0.0.1:8420
NEXUS_BASE_URL=http://127.0.0.1:8421
AUTH_HTTP_TIMEOUT=3s
# Nexus files uploads read and hash the body, so they get a longer budget.
FILES_HTTP_TIMEOUT=30s

# Email sign-in link landing page (Agora UI). Must match platformd's
# PLATFORMD_EMAIL_LINK_REDIRECT_URIS exactly, including the trailing slash.
AGORA_EMAIL_LINK_REDIRECT_URI=http://localhost:4321/

# Reverse proxies allowed to supply X-Forwarded-For (comma separated CIDRs)
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# Logging: one JSON object per line
LOG_LEVEL=info
LOG_FILE=logs/app.jsonl

# Run pending migrations from migrations/ at startup
AUTO_MIGRATE=true
