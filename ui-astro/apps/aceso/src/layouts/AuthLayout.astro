---
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="zh-CN" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — Aceso</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script>
      (function() {
        var theme = localStorage.getItem('aceso-theme') || 'dark';
        document.documentElement.className = theme;
      })();
    </script>
  </head>
  <body class="min-h-screen bg-bg text-fg antialiased">
    <div class="flex min-h-screen flex-col lg:flex-row">
      <!-- left: branding -->
      <div class="flex flex-1 flex-col items-center justify-center px-8 py-16 lg:px-16">
        <div class="max-w-md text-center lg:text-left">
          <div class="mb-6 flex items-center justify-center lg:justify-start gap-3">
            <span class="text-4xl">⚡</span>
            <h1 class="text-4xl font-bold tracking-tight text-fg-emphasis">Aceso</h1>
          </div>
          <p class="text-lg text-fg-muted leading-relaxed">
            医疗·养老·儿保一体化演示平台
          </p>
          <div class="mt-10 hidden lg:block">
            <ul class="space-y-4 text-sm text-fg-dimmed">
              <li class="flex items-start gap-3">
                <span class="mt-0.5 text-accent">✓</span>
                居民健康档案统一管理
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-0.5 text-accent">✓</span>
                老年人健康体检与随访
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-0.5 text-accent">✓</span>
                0-6 岁儿童健康管理
              </li>
            </ul>
          </div>
        </div>
      </div>
      <!-- right: form -->
      <div class="flex flex-1 items-center justify-center px-4 py-12 lg:px-8">
        <slot />
      </div>
    </div>
  </body>
</html>
