---
import "../styles/global.css";
import SessionGuard from "../components/SessionGuard.tsx";
import SignOutButton from "../components/SignOutButton.tsx";
import ThemeToggle from "../components/ThemeToggle.tsx";
import Sidebar from "../components/Sidebar.tsx";
import BreadcrumbTitle from "../components/BreadcrumbTitle.tsx";

interface Props {
  title: string;
  /**
   * 域相关页面的标题覆盖名（域 → 标签）。传入时会在首屏同步改写
   * `document.title`，避免静态 `<title>`（医疗基准名）先闪一下；
   * 口径与 `lib/domain.ts` 的 `PAGE_TITLE_DOMAIN_LABELS[path].labels`、
   * 以及运行期改写标题的 `BreadcrumbTitle` 完全一致。
   */
  titleDomainLabels?: Partial<Record<"医疗" | "养老" | "儿保", string>> | null;
}

const { title, titleDomainLabels = null } = Astro.props;
const titleLabels = titleDomainLabels ?? null;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="zh-CN" class="dark h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — Aceso</title>
    {
      titleLabels && (
        /* 经典（非 module）内联脚本：必须在 hydration 之前同步执行，才能在首屏就
           用 localStorage 里的域覆盖静态标题。`define:vars` 会阻止 Astro 打包，
           `is:inline` 再显式声明确保不会被提升为 type="module"。 */
        <script is:inline define:vars={{ titleLabels, titleFallback: title, domainStorageKey: "aceso-domain" }}>
          (function () {
            try {
              var domain = localStorage.getItem(domainStorageKey) || "医疗";
              var label = titleLabels[domain] || titleFallback;
              document.title = label + " — Aceso";
            } catch (error) {
              /* localStorage 不可用（隐私模式/被禁用）时保留静态标题 */
            }
          })();
        </script>
      )
    }
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script>
      (function() {
        var theme = localStorage.getItem('aceso-theme') || 'dark';
        document.documentElement.className = theme;
      })();
    </script>
  </head>
  <body class="min-h-screen bg-bg text-fg antialiased overflow-hidden">
    <SessionGuard client:only="react" />
    <div class="flex min-h-screen flex-col">
      <!-- Sidebar (fixed) -- full viewport height -->
    <Sidebar client:only="react" currentPath={currentPath} />

      <!-- Content -->
      <div class="flex flex-1 flex-col ml-[var(--sidebar-w)]">
        <header class="flex items-center justify-between h-[var(--topbar-h)] px-6 bg-surface border-b border-border shrink-0">
          <div class="flex items-center gap-3">
            <svg width="20" height="20" viewBox="0 0 32 32" fill="none" class="shrink-0">
              <rect x="2" y="2" width="28" height="28" rx="6" class="fill-accent/10 stroke-accent" stroke-width="1.5"/>
              <path d="M16 7L9.5 25h4.2l1.2-3.2h6.2l1.2 3.2h4.2L19 7h-3zm-1.3 11.2l2.3-6.2 2.3 6.2h-4.6z" class="fill-accent"/>
            </svg>
            <span class="text-sm font-semibold text-fg-emphasis">ACESO</span>
            <span class="text-sm text-fg-dimmed mx-2">/</span>
            <BreadcrumbTitle client:only="react" currentPath={currentPath} fallback={title} />
          </div>

          <div class="flex items-center gap-3">
            <ThemeToggle client:only="react" />
            <SignOutButton client:only="react" />
          </div>
        </header>

        <main class="flex flex-1 flex-col overflow-y-auto p-6">
          <slot />
        </main>
      </div>
    </div>
  </body>
</html>
