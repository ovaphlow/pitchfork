---
import "../styles/global.css";
import SessionGuard from "../components/SessionGuard.tsx";
import SignOutButton from "../components/SignOutButton.tsx";
import ThemeToggle from "../components/ThemeToggle.tsx";
import Sidebar from "../components/Sidebar.tsx";

interface Props {
  title: string;
}

const { title } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="zh-CN" class="dark h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — Aceso</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script>
      (function() {
        var theme = localStorage.getItem('aceso-theme') || 'dark';
        document.documentElement.className = theme;
      })();
    </script>
  </head>
  <body class="h-full bg-bg text-fg antialiased overflow-hidden">
    <SessionGuard client:load />
    <div class="flex h-full flex-col">
      <!-- Sidebar (fixed) -- full viewport height -->
    <Sidebar client:load currentPath={currentPath} />

      <!-- Content -->
      <div class="flex flex-1 flex-col ml-[var(--sidebar-w)]">
        <header class="flex items-center justify-between h-[var(--topbar-h)] px-6 bg-surface border-b border-border shrink-0">
          <div class="flex items-center gap-3">
            <svg width="20" height="20" viewBox="0 0 32 32" fill="none" class="shrink-0">
              <rect x="2" y="2" width="28" height="28" rx="6" class="fill-accent/10 stroke-accent" stroke-width="1.5"/>
              <path d="M16 7L9.5 25h4.2l1.2-3.2h6.2l1.2 3.2h4.2L19 7h-3zm-1.3 11.2l2.3-6.2 2.3 6.2h-4.6z" class="fill-accent"/>
            </svg>
            <span class="text-sm font-semibold text-fg-emphasis">ACESO</span>
            <span class="text-sm text-fg-dimmed mx-2">/</span>
            <span class="text-sm text-fg font-medium">{title}</span>
          </div>

          <div class="flex items-center gap-3">
            <ThemeToggle client:load />
            <SignOutButton client:load />
          </div>
        </header>

        <main class="flex-1 overflow-y-auto p-6">
          <slot />
        </main>
      </div>
    </div>
  </body>
</html>
