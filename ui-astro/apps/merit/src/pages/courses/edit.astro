---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CourseForm from "../../components/courses/CourseForm.svelte";

// 静态 CSR 应用：课程 ID 经查询参数传入（与 aceso 既有静态路由模式一致），
// 组件在客户端按 URL 查询参数回退解析。
const courseId = Astro.url.searchParams.get("id") ?? "";
---

<BaseLayout title="编辑课程">
  <main class="mx-auto w-full max-w-3xl px-6 py-10">
    <CourseForm client:load mode="edit" courseId={courseId} />
  </main>
</BaseLayout>
