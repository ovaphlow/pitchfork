---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PaperDetail from "../../components/papers/PaperDetail.svelte";

// 静态 CSR 应用：试卷 ID 经查询参数传入（与 aceso 既有静态路由模式一致），
// 组件在客户端按 URL 查询参数回退解析。
const paperId = Astro.url.searchParams.get("id") ?? "";
---

<BaseLayout title="试卷详情与组卷">
  <main class="mx-auto w-full max-w-4xl px-6 py-10">
    <PaperDetail client:load paperId={paperId} />
  </main>
</BaseLayout>
