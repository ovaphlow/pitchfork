{
  "name": "ui-astro",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter @pitchfork/aceso dev",
    "build": "bun run --filter '*' build",
    "preview": "bun run --filter @pitchfork/aceso preview",
    "dev:aceso": "bun run --filter @pitchfork/aceso dev",
    "build:aceso": "bun run --filter '*' build",
    "preview:aceso": "bun run --filter @pitchfork/aceso preview",
    "test:e2e": "playwright test",
    "test:e2e:aceso": "playwright test apps/aceso/e2e/elderly-care-lifecycle.spec.ts --project=chromium",
    "test:unit:aceso": "node --test apps/aceso/tests/*.test.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.10",
    "pg": "^8.13.1"
  }
}
