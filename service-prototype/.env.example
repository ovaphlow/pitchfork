# prototyped configuration template. Copy to .env and export, or set in
# the environment directly:
#   cp .env.example .env
#   set -a; . ./.env; set +a
PORT=8423
# PostgreSQL（本服务数据库为可选项：DB 不可用时服务仍启动，仅记录日志）
# 方式一：DATABASE_URL 直接指定完整 DSN（优先级最高，提供后以下 PITCHFORK_DB_* 不参与）
# DATABASE_URL=postgres://ovaphlow:change-me@127.0.0.1:5433/ovaphlow
# 方式二：离散变量（未提供 DATABASE_URL 时生效；PITCHFORK_DB_PASSWORD 必填）
# PITCHFORK_DB_HOST=127.0.0.1
# PITCHFORK_DB_PORT=5433
# PITCHFORK_DB_USER=ovaphlow
# PITCHFORK_DB_NAME=ovaphlow
# PITCHFORK_DB_PASSWORD=change-me
