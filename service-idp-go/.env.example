export IDENTITYD_ADDR=127.0.0.1:8420
export IDENTITYD_DATABASE_PATH=.data/identityd.sqlite
export IDENTITYD_BOOTSTRAP_IDENTIFIER=admin
export IDENTITYD_BOOTSTRAP_PASSWORD=change-this-before-first-run
export IDENTITYD_SESSION_TTL=12h
export IDENTITYD_SESSION_IDLE_TTL=30m
export IDENTITYD_LOGIN_THROTTLE_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
export IDENTITYD_LOGIN_THROTTLE_WINDOW=15m
export IDENTITYD_LOGIN_THROTTLE_LOCKOUT=15m
export IDENTITYD_LOGIN_THROTTLE_FAILURES=5
export IDENTITYD_SESSION_SECURE_COOKIE=false
export IDENTITYD_PUBLIC_URL=https://identity.example.internal/crate-api/identity/v1
export IDENTITYD_TRUSTED_PROXY_CIDRS=127.0.0.1/32
export IDENTITYD_CORS_ORIGINS=http://localhost:4324,http://127.0.0.1:4324
