---
import App from "../components/App.svelte";
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <App client:only="svelte" />
  <noscript>
    <div
      class="mx-auto flex min-h-dvh w-full max-w-[27rem] items-center px-5 text-bone sm:max-w-[40rem]"
    >
      <p class="text-[15px] leading-6 text-muted" lang="zh-CN">
        栖木在客户端渲染界面。请启用 JavaScript 后打开工作区。
      </p>
      <p class="mt-3 text-[15px] leading-6 text-muted" lang="en">
        Qimu renders its interface on the client. Enable JavaScript to open the
        workspace.
      </p>
    </div>
  </noscript>
</Layout>
