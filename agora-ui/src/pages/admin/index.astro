---
import AdminApp from "../../components/AdminApp.svelte";
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="机构审核 · 栖木"
  description="平台管理员使用的机构审核工作台，与求职、招聘界面相互独立。"
>
  <AdminApp client:only="svelte" />
  <noscript>
    <div
      class="mx-auto flex min-h-dvh w-full max-w-[27rem] items-center px-5 text-bone sm:max-w-[40rem]"
    >
      <p class="text-[15px] leading-6 text-muted" lang="zh-CN">
        管理台在客户端渲染。请启用 JavaScript 后打开。
      </p>
      <p class="mt-3 text-[15px] leading-6 text-muted" lang="en">
        The admin console renders on the client. Enable JavaScript to open it.
      </p>
    </div>
  </noscript>
</Layout>
